#!/bin/bash
# ENGINE-RENDERED by devops-agent — first-boot setup of the Docker Compose host (Amazon Linux 2023):
# Docker from the OS packages, Docker Compose from its official release VERIFIED against the published
# checksum, the app directory the deploy unpacks into. Changing it replaces the host.
set -euxo pipefail
dnf install -y docker
systemctl enable --now docker
install -d -m 0755 /usr/local/lib/docker/cli-plugins /opt/app
cd /tmp
url="https://github.com/docker/compose/releases/download/${compose_version}/docker-compose-linux-${compose_arch}"
curl -fsSL --retry 5 -o docker-compose "$url"
curl -fsSL --retry 5 -o docker-compose.sha256 "$url.sha256"
echo "$(cut -d' ' -f1 docker-compose.sha256)  docker-compose" | sha256sum -c -
install -m 0755 docker-compose /usr/local/lib/docker/cli-plugins/docker-compose
docker compose version
